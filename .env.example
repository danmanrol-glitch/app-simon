# Copia este archivo como .env (desarrollo local) y configura las mismas variables
# en Vercel > Project > Settings > Environment Variables (producción).
# Guía completa: SUPABASE_SETUP.txt

# --- Supabase (obligatorio) ---
# Project Settings > API. Son públicas por diseño (las protege RLS).
# Nunca pongas aquí la service_role key ni la secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Servidor: moderación de la Comunidad (obligatoria) ---
# Supabase > Project Settings > API Keys > Secret keys > crear una nueva (sb_secret_...).
# SOLO en Vercel (Environment Variables) o en tu .env local. Nunca en el repo ni con prefijo VITE_.
SUPABASE_SECRET_KEY=
# Modelo de Gemini para moderar (opcional). Por defecto: gemini-3.5-flash-lite
GEMINI_MODERATION_MODEL=

# --- EAN Assistant (IA) ---
# IMPORTANTE: estas NO llevan el prefijo VITE_, para que nunca lleguen al navegador.
# Proveedor: gemini (por defecto) o anthropic.
AI_PROVIDER=gemini

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo (opcional). Por defecto: gemini-3.5-flash-lite (el más disponible; cambia a gemini-3.8-flash si tienes plan pago)
GEMINI_MODEL=
# Modelos de respaldo si el principal está saturado (opcional, separados por coma).
# Por defecto: gemini-3.8-flash,gemini-3.6-flash
GEMINI_FALLBACK_MODELS=

# Claude (opcional): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo (opcional). Por defecto: claude-opus-5-5
ANTHROPIC_MODEL=
