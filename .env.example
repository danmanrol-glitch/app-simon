# Copia este archivo como .env (desarrollo local) o configura las variables en
# Vercel > Project > Settings > Environment Variables (producción).
# IMPORTANTE: no uses el prefijo VITE_. Vite publica en el navegador toda variable VITE_*.

# Proveedor de IA: gemini (por defecto) o anthropic.
# Si lo dejas vacío, se usa Gemini cuando GEMINI_API_KEY tiene valor.
AI_PROVIDER=gemini

# --- Gemini (proveedor actual) ---
# API key de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo (opcional). Por defecto: gemini-3.8-flash
GEMINI_MODEL=

# --- Claude (opcional, para cambiar de proveedor más adelante) ---
# API key de Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo (opcional). Por defecto: claude-opus-5-5
ANTHROPIC_MODEL=
