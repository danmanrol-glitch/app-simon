# Copia este archivo como .env (desarrollo local) o configura las variables en
# Vercel > Project > Settings > Environment Variables (producción).
# IMPORTANTE: no uses el prefijo VITE_. Vite publica en el navegador toda variable VITE_*.

# API key de Anthropic (obligatoria). Se obtiene en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modelo de Claude (opcional). Por defecto: claude-opus-5-5
# Alternativa más económica para un chat de alto volumen: claude-haiku-5-5
ANTHROPIC_MODEL=
